rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
//  MAINTIX — RÈGLES FIRESTORE PRODUCTION
//  Réseau interne fermé · Sécurité intermédiaire
//  Généré le : 2026-07-13
//
//  PHILOSOPHIE :
//  • Lectures   : libres pour toutes les collections (listeners temps réel)
//  • Écritures  : libres sur les collections opérationnelles
//  • Config     : écriture réservée à l'Administrateur (Firebase Auth)
//  • Suppressions critiques : bloquées au niveau serveur
//  • Philosophie GMAO : missions jamais supprimées (archivage archived:true)
//
//  AUTHENTIFICATION :
//  • Administrateur  → Firebase Auth (request.auth != null)
//  • Responsable     → PIN Firestore (pas de Firebase Auth → request.auth null)
//  • Technicien      → PIN Firestore (pas de Firebase Auth → request.auth null)
//
//  NE PAS DÉPLOYER SANS AVOIR RELU CE FICHIER.
//  Commande de déploiement : firebase deploy --only firestore:rules
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────────
    // HELPER : Administrateur Firebase Auth
    // Exclut explicitement le provider "anonymous" : depuis l'ajout de la
    // connexion anonyme (bootstrap client pour les techniciens/responsables
    // PIN, voir firebase-config.js), request.auth != null seul ne suffit
    // plus à identifier un Administrateur — il faut vérifier qu'il s'agit
    // d'une vraie session e-mail/mot de passe.
    // ────────────────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ────────────────────────────────────────────────────────────────────────
    // HELPER : session applicative authentifiée (Admin OU PIN via bootstrap
    // anonyme). Ne prouve PAS l'identité du technicien/responsable (le PIN
    // lui-même n'est vérifié que côté client), mais exige un vrai jeton
    // Firebase Auth — ce qui exclut toute requête faite sans jamais passer
    // par le SDK/l'app (ex. appel REST direct sans authentification).
    // ────────────────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }


    // ════════════════════════════════════════════════════════════════════════
    // GROUPE A — COLLECTIONS PROTÉGÉES
    // Écriture restreinte · Suppression interdite ou admin uniquement
    // ════════════════════════════════════════════════════════════════════════

    // ── CONFIG ──────────────────────────────────────────────────────────────
    // Documents : week, teams, alerts, assignments, checks, notes, planning,
    //             bible_permissions, games_config, hotel_config, versions,
    //             maintenance.
    // Lecture   : libre (listeners db.js, Cloud Functions)
    // Écriture  : Admin uniquement (Firebase Auth)
    // Suppression : JAMAIS — configuration structurelle de l'application
    match /config/{docId} {
      allow read: if true;
      allow create, update: if isAdmin();
      // delete : interdit — aucune suppression de config

      // Sous-collection : config/maintenance/deploy_log
      // Journal de déploiement en append-only
      match /deploy_log/{logId} {
        allow read: if true;
        allow create: if isAdmin();
        // update, delete : interdit
      }
    }

    // config/checks & config/notes : exceptions à la règle "config = Admin
    // Firebase Auth uniquement" ci-dessus. Ce sont des documents OPÉRATIONNELS
    // (état des cases cochées / notes de tâche des check-lists), écrits en
    // continu par les techniciens ET les responsables — qui s'authentifient
    // par PIN Firestore, jamais par un compte e-mail/mot de passe. Le
    // isAdmin() ci-dessus bloquait donc TOUTE validation de tâche pour ces
    // deux rôles ("Erreur de connexion" au clic sur Valider).
    // Écriture réservée à isAuthenticated() (PAS "if true") : le client
    // (firebase-config.js) ouvre désormais une session Firebase Auth anonyme
    // au chargement pour TOUTE l'app, y compris les utilisateurs PIN. Un
    // appel direct à l'API Firestore sans jamais passer par le SDK Firebase
    // Auth (donc sans jeton) reste refusé ; ceci ne remplace pas une vraie
    // vérification d'identité par technicien (le PIN n'est validé que côté
    // client), qui nécessiterait une Cloud Function + jetons personnalisés.
    // Ce chemin plus précis prend le pas sur /config/{docId} pour ces deux
    // documents uniquement — le reste de /config/* reste Admin-only.
    match /config/checks {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }
    match /config/notes {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    // Lecture   : libre (auth.js lit les utilisateurs pour valider le PIN)
    // Création  : Admin uniquement
    // Mise à jour : libre (mise à jour profil, planningOrder, avatarUrl, PIN)
    // Suppression : Admin uniquement (panneau admin)
    match /users/{userId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if true;
      allow delete: if isAdmin();
    }

    // ── ROLES ────────────────────────────────────────────────────────────────
    // Lecture   : libre (auth.js charge les permissions par roleId)
    // Écriture  : Admin uniquement
    // Suppression : Admin uniquement (panneau admin)
    match /roles/{roleId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── CSO_PERF_CONFIG ──────────────────────────────────────────────────────
    // Configuration performance énergétique (seuils, classes, objectifs)
    // Écriture  : libre (consommations.js → settings)
    // Suppression : JAMAIS — configuration structurelle
    match /cso_perf_config/{docId} {
      allow read: if true;
      allow create, update: if true;
      // delete : interdit
    }

    // ── ALERT_RULES ──────────────────────────────────────────────────────────
    // Règles d'alertes configurées (admin.js, app.js)
    // Écriture  : libre (responsable peut configurer les alertes)
    // Suppression : JAMAIS — protection contre suppression accidentelle
    match /alert_rules/{docId} {
      allow read: if true;
      allow create, update: if true;
      // delete : interdit
    }

    // ── FCMTOKENS ────────────────────────────────────────────────────────────
    // Tokens push notification (client : set/delete sur login/logout)
    // Cloud Functions gèrent les tokens expirés via Admin SDK (hors règles)
    match /fcmTokens/{tokenId} {
      allow read, create, update, delete: if true;
    }


    // ════════════════════════════════════════════════════════════════════════
    // GROUPE B — COLLECTIONS OPÉRATIONNELLES
    // Lecture + écriture libres · Suppression selon usage réel audité
    // ════════════════════════════════════════════════════════════════════════

    // ── PRÉSENCE & PRÉFÉRENCES ───────────────────────────────────────────────
    // Heartbeat toutes les 2 min (presence). Favoris de navigation (user_prefs).
    // Pas de suppression utilisée dans le code actuel.
    match /presence/{docId} {
      allow read, create, update: if true;
    }
    match /user_prefs/{docId} {
      allow read, create, update: if true;
    }

    // ── CHECKLISTS ───────────────────────────────────────────────────────────
    // tasks : batch.set uniquement, jamais supprimé → pas de delete
    match /tasks/{docId} {
      allow read, create, update: if true;
    }

    // weekly_checks : delete utilisé (suppression de templates)
    match /weekly_checks/{docId} {
      allow read, create, update, delete: if true;
    }

    // weekHistory : batch.delete pour purge 30 jours
    match /weekHistory/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── MISSIONS ─────────────────────────────────────────────────────────────
    // PHILOSOPHIE GMAO : suppression physique réservée à l'Admin via Corbeille.
    // Cycle normal : opérationnel → inTrash:true → archived:true → delete (Admin).
    match /missions/{docId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // ── INTERVENTIONS ────────────────────────────────────────────────────────
    // PHILOSOPHIE GMAO : suppression physique réservée à l'Admin via Corbeille.
    // Le JS remplace les .delete() par MX.Trash.sendToTrash().
    match /interventions/{docId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Transferts liés aux interventions — pas de delete dans le code
    match /int_transfers/{docId} {
      allow read, create, update: if true;
    }

    // ── RESP_TASKS ───────────────────────────────────────────────────────────
    match /resp_tasks/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── TASK_PHOTOS ──────────────────────────────────────────────────────────
    // arrayUnion uniquement (ajout de photos) — jamais supprimé
    match /task_photos/{docId} {
      allow read, create, update: if true;
    }

    // ── LOGS TECHNIQUES ──────────────────────────────────────────────────────
    // clearLogs supprime les anciennes entrées — delete autorisé
    match /logs/{docId} {
      allow read, create, delete: if true;
    }

    // ── PLANNING ─────────────────────────────────────────────────────────────
    match /planning_entries/{docId} {
      allow read, create, update, delete: if true;
    }
    match /planning_shifts/{docId} {
      allow read, create, update, delete: if true;
    }
    match /absences/{docId} {
      allow read, create, update, delete: if true;
    }
    // daily_claims : set merge uniquement, pas de delete
    match /daily_claims/{docId} {
      allow read, create, update: if true;
    }

    // ── PMP — MAINTENANCE PRÉVENTIVE ─────────────────────────────────────────
    // pmp_equipments : batch.delete sur suppression équipement — autorisé
    // (les équipements sont des entrées de configuration, pas des historiques)
    match /pmp_equipments/{docId} {
      allow read, create, update, delete: if true;
    }
    // pmp_interventions : PHILOSOPHIE GMAO — historique d'interventions
    // Le JS utilise MX.Trash.sendToTrash() au lieu de .delete().
    // Suppression physique uniquement depuis Corbeille (Admin).
    match /pmp_interventions/{docId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }
    // pmp_plans : PHILOSOPHIE GMAO — plans de maintenance = données critiques
    // Suppression physique uniquement depuis Corbeille (Admin).
    match /pmp_plans/{docId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }
    match /pmp_templates/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── STOCK ────────────────────────────────────────────────────────────────
    match /products/{docId} {
      allow read, create, update, delete: if true;
    }
    match /orders/{docId} {
      allow read, create, update, delete: if true;
    }
    match /transfers/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── MESSAGES & JOURNAL ───────────────────────────────────────────────────
    // messages : delete autorisé (suppression de messages)
    match /messages/{docId} {
      allow read, create, delete: if true;
    }

    // announcements + sous-collection replies
    match /announcements/{annId} {
      allow read, create, update, delete: if true;

      match /replies/{replyId} {
        allow read, create, delete: if true;
      }
    }

    // admin_journal : delete autorisé (purge manuelle)
    match /admin_journal/{docId} {
      allow read, create, delete: if true;
    }

    // ── NOTIFICATIONS ────────────────────────────────────────────────────────
    match /notifications/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── BADGES ───────────────────────────────────────────────────────────────
    // delete utilisé (admin supprime un badge + cascade user_badges)
    match /badges/{docId} {
      allow read, create, update, delete: if true;
    }
    match /user_badges/{docId} {
      allow read, create, delete: if true;
    }

    // ── GAMIFICATION — REWARDS ───────────────────────────────────────────────
    match /rewards_rules/{docId} {
      allow read, create, update, delete: if true;
    }
    match /rewards_grades/{docId} {
      allow read, create, update, delete: if true;
    }
    match /rewards_items/{docId} {
      allow read, create, update, delete: if true;
    }
    // rewards_history : delete lors du resetProfile
    match /rewards_history/{docId} {
      allow read, create, delete: if true;
    }
    // rewards_users : set merge (increment points/xp) — pas de delete
    match /rewards_users/{docId} {
      allow read, create, update: if true;
    }

    // ── GAMIFICATION — MINI-JEUX ─────────────────────────────────────────────
    // games_scores : delete pour reset du classement
    match /games_scores/{docId} {
      allow read, create, delete: if true;
    }
    // games_achievements : delete lors du resetProfile
    match /games_achievements/{docId} {
      allow read, create, delete: if true;
    }
    match /games_questions/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── BIBLE MAINTIX ────────────────────────────────────────────────────────
    // delete utilisé (suppression article + cascade comments)
    match /bible_articles/{docId} {
      allow read, create, update, delete: if true;
    }
    match /bible_comments/{docId} {
      allow read, create, delete: if true;
    }
    match /bibleCategories/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── CONSOMMATIONS ÉNERGÉTIQUES ───────────────────────────────────────────
    match /cso_meters/{docId} {
      allow read, create, update, delete: if true;
    }
    // cso_readings : batch.update pour recalcul des consommations
    match /cso_readings/{docId} {
      allow read, create, update, delete: if true;
    }
    match /cso_clients/{docId} {
      allow read, create, update, delete: if true;
    }
    match /cso_energy_alerts/{docId} {
      allow read, create, update, delete: if true;
    }
    // cso_activity_log : append-only — pas de update ni delete
    match /cso_activity_log/{docId} {
      allow read, create: if true;
    }
    // cso_charts : graphiques personnalisés PARTAGÉS (onglet Analyses).
    // RÈGLE PROVISOIRE : l'authentification actuelle par PIN ne permet pas
    // de distinguer Responsable/Technicien côté serveur (session Firebase
    // Auth anonyme commune, voir firebase-config.js) — isAuthenticated()
    // autorise donc tout utilisateur ayant chargé l'application (Admin ou
    // PIN) à lire/créer/modifier/supprimer, SANS distinction de rôle. Ce
    // n'est PAS une sécurité complète : elle bloque uniquement un accès
    // direct à l'API sans jamais être passé par l'app (contrairement à
    // `allow read, write: if true`, qui ne bloquerait même pas cela). La
    // distinction fine par rôle nécessitera des Custom Claims, prévue avec
    // la future architecture utilisateurs/multi-sites — pas traitée ici.
    match /cso_charts/{docId} {
      allow read:                   if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // ── ALERTES DÉCLENCHÉES ──────────────────────────────────────────────────
    // batch.delete pour purger les anciennes alertes
    match /triggered_alerts/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── ORGANISATION RESPONSABLE ──────────────────────────────────────────────
    // delete utilisé (suppression tâche hebdomadaire)
    match /org_tasks/{docId} {
      allow read, create, update, delete: if true;
    }

    // ── ORG CONFIG (slot configuration par semaine) ───────────────────────────
    // Pas de suppression — configuration préservée même pour les semaines passées
    match /org_config/{docId} {
      allow read, create, update: if true;
    }

    // ── ORG TEMPLATES (modèles de journée) ───────────────────────────────────
    // delete autorisé (suppression d'un modèle par le responsable)
    match /org_templates/{docId} {
      allow read, create, update, delete: if true;
    }

  }
}
