      // Mêmes garanties de claims qu'à la création ci-dessus (sign_in_
      // provider + userId jamais falsifiables côté client).
      allow update: if isAdmin()
        || (
          isPinRole('responsable')
          && !_isResponsable(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin'])
          && request.resource.data.pin is string
        )
        || (
          request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'custom'
          && ('userId' in request.auth.token)
          && request.auth.token.userId == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin'])
          && request.resource.data.pin is string
        );
      allow delete: if isAdmin();
    }

