rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
//  MAINTIX — RÈGLES FIRESTORE PRODUCTION
//  Réseau interne fermé · Sécurité intermédiaire
//  Généré le : 2026-07-13
//
//  PHILOSOPHIE :
//  • Lectures   : libres pour toutes les collections (listeners temps réel)
//  • Écritures  : libres sur les collections opérationnelles
//  • Config     : écriture réservée à l'Administrateur (Firebase Auth)
//  • Suppressions critiques : bloquées au niveau serveur
//  • Philosophie GMAO : missions jamais supprimées (archivage archived:true)
//
//  AUTHENTIFICATION :
//  • Administrateur  → Firebase Auth (request.auth != null)
//  • Responsable     → PIN Firestore (pas de Firebase Auth → request.auth null)
//  • Technicien      → PIN Firestore (pas de Firebase Auth → request.auth null)
//
//  NE PAS DÉPLOYER SANS AVOIR RELU CE FICHIER.
//  Commande de déploiement : firebase deploy --only firestore:rules
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────────────────────────────────────────────────────────
    // HELPER : Administrateur Firebase Auth
    // Exclut explicitement le provider "anonymous" : depuis l'ajout de la
    // connexion anonyme (bootstrap client pour les techniciens/responsables
    // PIN, voir firebase-config.js), request.auth != null seul ne suffit
    // plus à identifier un Administrateur — il faut vérifier qu'il s'agit
    // d'une vraie session e-mail/mot de passe.
    //
    // ⚠ MIGRATION CUSTOM CLAIMS (functions/index.js:verifyPin) : exclut
    // DÉSORMAIS AUSSI le provider "custom" — les comptes PIN authentifiés
    // par verifyPin()/signInWithCustomToken() ont request.auth != null ET
    // sign_in_provider == 'custom' (jamais 'anonymous'). Sans cette
    // exclusion supplémentaire, TOUT technicien ou responsable passerait
    // isAdmin() == true partout dans l'application dès le déploiement de
    // cette migration — régression de sécurité majeure et silencieuse,
    // repérée uniquement parce que ce fichier a été relu intégralement
    // avant toute modification (voir consigne : "examiner les effets de
    // bord sur les fonctionnalités existantes avant toute modification des
    // règles"). Isoler cette vérification ici garantit que CHAQUE usage
    // existant de isAdmin() dans ce fichier reste correct sans modification
    // supplémentaire.
    // ────────────────────────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider != 'anonymous'
          && request.auth.token.firebase.sign_in_provider != 'custom';
    }

    // ────────────────────────────────────────────────────────────────────────
    // HELPERS : rôles PIN vérifiés côté serveur (migration custom claims)
    // Un compte PIN authentifié via verifyPin() porte un jeton avec
    // sign_in_provider == 'custom' et un claim `role` ('responsable' ou
    // 'technicien'), posé UNIQUEMENT par la Cloud Function (Admin SDK,
    // jamais modifiable par le client — voir functions/index.js:verifyPin).
    // Ne jamais lire un rôle depuis request.resource.data (donnée du
    // document écrit par le client) : seul request.auth.token est fiable.
    // ────────────────────────────────────────────────────────────────────────
    function isPinRole(r) {
      return request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'custom'
          && ('role' in request.auth.token)
          && request.auth.token.role == r;
    }
    function isResponsableOrAdmin() {
      return isAdmin() || isPinRole('responsable');
    }
    function isAnyVerifiedRole() {
      return isAdmin() || isPinRole('responsable') || isPinRole('technicien');
    }

    // HELPER (REFONTE CTA/VC) : un point de mesure à 2 points
    // (heating_readings.points.point1/point2) est-il structurellement
    // valide ? Mêmes bornes physiques que l'ancien champ plat `temp`
    // (-50/100°C) pour les 3 sous-mesures — volontairement permissif sur
    // les BORNES (le plafond métier réel, ex. 50°C VC, est appliqué par
    // MX.HeatingEngine côté client ET revalidé lors de la décision
    // Responsable/Admin, pas ici : cette règle ne garantit que la forme des
    // données, jamais la pertinence métier d'une valeur).
    function _validHeatingPoint(p) {
      return p is map
        && p.waterTemp is number && p.waterTemp > -50 && p.waterTemp < 100
        && p.blowTemp is number && p.blowTemp > -50 && p.blowTemp < 100
        && p.ambientTemp is number && p.ambientTemp > -50 && p.ambientTemp < 100;
    }

    // ────────────────────────────────────────────────────────────────────────
    // HELPER : le document users/{userId} CIBLÉ appartient-il à un
    // Responsable ? Règle métier explicite (section A.2 du rapport) : un
    // Responsable peut réinitialiser le PIN de n'importe quel TECHNICIEN,
    // mais JAMAIS celui d'un AUTRE Responsable (Kevin ne peut pas changer le
    // PIN d'Alban, ni l'inverse) — seul l'Admin le peut. Nécessite une
    // lecture Firestore du document CIBLE (get()), pas du jeton de
    // l'appelant : le rôle de la CIBLE n'est jamais un claim du jeton de
    // celui qui écrit. Même logique à deux champs que _normalizeRole() côté
    // serveur (functions/index.js) et isResponsable()/_roleFamily() côté
    // client (auth.js) — rank='responsable' OU role='responsable' comptent
    // tous les deux, à resynchroniser manuellement si cette règle évolue.
    // exists() d'abord : un users/{userId} absent (ne devrait jamais
    // arriver en usage normal — users_private n'est créé qu'après un
    // users/{id} existant, voir db.js:addUser) est traité comme "pas un
    // Responsable" par défaut FAUX-FERMÉ ici (l'absence du doc renvoie
    // false à exists(), donc _isResponsable() renvoie false, donc le
    // Responsable appelant serait AUTORISÉ) — acceptable uniquement parce
    // que ce cas ne peut concerner qu'un compte déjà inexistant pour
    // l'app ; aucune tentative légitime ne cible un tel id.
    // Map.get(clé, défaut) plutôt que la notation pointée .rank/.role :
    // un champ ABSENT en notation pointée lève une erreur d'évaluation
    // (pas une simple valeur "null") — avec seulement deux champs
    // optionnels liés par ||, cela pouvait, pour un technicien sans champ
    // `rank` (le cas courant), faire échouer toute l'expression au lieu de
    // renvoyer proprement `false`, refusant à tort une écriture légitime
    // (faux négatif fonctionnel, pas une faille de sécurité, mais à éviter).
    function _isResponsable(userId) {
      let p = /databases/$(database)/documents/users/$(userId);
      return exists(p)
          && (get(p).data.get('rank', '') == 'responsable' || get(p).data.get('role', '') == 'responsable');
    }

    // ────────────────────────────────────────────────────────────────────────
    // HELPER : Super-admin — UN seul compte Firebase Auth, en dur ici (pas de
    // custom claims/Cloud Functions dans ce projet). Restreint l'écriture des
    // documents explicitement réservés au Super Admin : config/adminSession
    // (révocation forcée des sessions admin) et config/navigation_visibility
    // (visibilité des menus par profil). N'utiliser ce helper QUE pour ces
    // fonctionnalités explicitement Super-Admin-only ; ne PAS l'utiliser
    // comme substitut/alias de isAdmin() pour des fonctionnalités ouvertes à
    // tout admin/responsable ailleurs dans ce fichier.
    // ────────────────────────────────────────────────────────────────────────
    function isSuperAdmin() {
      return isAdmin() && request.auth.token.email == 'keyzeur94460@hotmail.fr';
    }

    // ────────────────────────────────────────────────────────────────────────
    // HELPER : session applicative authentifiée (Admin OU PIN via bootstrap
    // anonyme). Ne prouve PAS l'identité du technicien/responsable (le PIN
    // lui-même n'est vérifié que côté client), mais exige un vrai jeton
    // Firebase Auth — ce qui exclut toute requête faite sans jamais passer
    // par le SDK/l'app (ex. appel REST direct sans authentification).
    // ────────────────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }


    // ════════════════════════════════════════════════════════════════════════
    // GROUPE A — COLLECTIONS PROTÉGÉES
    // Écriture restreinte · Suppression interdite ou admin uniquement
    // ════════════════════════════════════════════════════════════════════════

    // ── CONFIG ──────────────────────────────────────────────────────────────
    // Documents : week, teams, alerts, assignments, checks, notes, planning,
    //             bible_permissions, games_config, hotel_config, versions,
    //             maintenance.
    // Lecture   : libre (listeners db.js, Cloud Functions)
    // Écriture  : Admin uniquement (Firebase Auth)
    // Suppression : JAMAIS — configuration structurelle de l'application
    //
    // IMPORTANT — sémantique réelle des règles Firestore : quand plusieurs
    // blocs "match" correspondent au même chemin (ex. ce bloc générique ET
    // le bloc précis config/navigation_visibility plus bas), Firestore
    // AUTORISE la requête si N'IMPORTE LEQUEL des blocs correspondants
    // l'autorise (union/OR — PAS "le plus précis l'emporte"). Un bloc précis
    // plus restrictif ne fait donc RIEN tant que ce bloc générique reste
    // permissif pour ce même docId : il faut l'exclure explicitement ici.
    // docId != 'navigation_visibility' : cette configuration (Visibilité des
    // modules) a sa propre règle Super-Admin-only plus bas — sans cette
    // exclusion, N'IMPORTE QUEL admin Firebase pourrait la modifier via ce
    // bloc générique, contournant silencieusement la restriction.
    match /config/{docId} {
      allow read: if true;
      // 'heating_config' exclu (PASSE DE FIABILISATION) : sans cette
      // exclusion, le isAdmin() large de CETTE règle générique s'OR-ait
      // avec la règle spécifique match /config/heating_config ci-dessous
      // (les blocs match qui correspondent au même chemin se cumulent en
      // OR dans Firestore) et permettrait à tout Admin Firebase d'écrire
      // n'importe quel champ, y compris hors bornes, en contournant
      // entièrement la validation de heating_config — exactement le
      // défaut qui excluait déjà 'navigation_visibility' pour la même
      // raison structurelle.
      allow create, update: if isAdmin() && docId != 'navigation_visibility' && docId != 'heating_config';
      // delete : interdit — aucune suppression de config

      // Sous-collection : config/maintenance/deploy_log
      // Journal de déploiement en append-only
      match /deploy_log/{logId} {
        allow read: if true;
        allow create: if isAdmin();
        // update, delete : interdit
      }
    }

    // config/checks & config/notes : exceptions à la règle "config = Admin
    // Firebase Auth uniquement" ci-dessus. Ce sont des documents OPÉRATIONNELS
    // (état des cases cochées / notes de tâche des check-lists), écrits en
    // continu par les techniciens ET les responsables — qui s'authentifient
    // par PIN Firestore, jamais par un compte e-mail/mot de passe. Le
    // isAdmin() ci-dessus bloquait donc TOUTE validation de tâche pour ces
    // deux rôles ("Erreur de connexion" au clic sur Valider).
    // Écriture réservée à isAuthenticated() (PAS "if true") : le client
    // (firebase-config.js) ouvre désormais une session Firebase Auth anonyme
    // au chargement pour TOUTE l'app, y compris les utilisateurs PIN. Un
    // appel direct à l'API Firestore sans jamais passer par le SDK Firebase
    // Auth (donc sans jeton) reste refusé ; ceci ne remplace pas une vraie
    // vérification d'identité par technicien (le PIN n'est validé que côté
    // client), qui nécessiterait une Cloud Function + jetons personnalisés.
    // Ce chemin plus précis prend le pas sur /config/{docId} pour ces deux
    // documents uniquement — le reste de /config/* reste Admin-only.
    match /config/checks {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }
    match /config/notes {
      allow read: if true;
      allow create, update: if isAuthenticated();
    }

    // config/adminSession : version de session admin (mécanisme de
    // révocation forcée des sessions Firebase Admin résiduelles sur un
    // poste partagé — voir auth.js). Lecture libre (tout admin doit pouvoir
    // vérifier sa propre version périodiquement) ; écriture réservée au
    // SEUL super-admin — plus restrictif que /config/{docId} (isAdmin()),
    // donc prend le pas dessus pour ce document précis.
    match /config/adminSession {
      allow read: if true;
      allow create, update: if isSuperAdmin();
    }

    // config/navigation_visibility : configuration de visibilité des menus
    // par profil (technicien/responsable), gérée depuis l'écran Super Admin
    // "Visibilité des modules" (voir assets/js/pages/nav-visibility.js).
    // Lecture libre (tout client doit pouvoir filtrer sa propre navigation) ;
    // écriture réservée au SEUL super-admin. Le bloc /config/{docId}
    // ci-dessus exclut explicitement ce docId de son propre "allow write" —
    // sans cette exclusion, sa condition isAdmin() (union/OR avec ce bloc-
    // ci, voir commentaire plus haut) permettrait à N'IMPORTE QUEL admin
    // Firebase d'écrire ce document malgré cette règle. Un admin Firebase
    // non-super-admin ne doit jamais pouvoir modifier cette configuration,
    // y compris par appel direct à l'API — vérifié par
    // tests/firestore_rules_navigation_visibility_test.js (émulateur réel).
    match /config/navigation_visibility {
      allow read: if true;
      allow create, update: if isSuperAdmin();
    }

    // config/heating_config : référence DJU configurable + bornes CTA/VC +
    // seuils d'alerte (REFONTE CTA/VC). Document de PILOTAGE (comme la
    // gestion des circuits ci-dessous) : écriture Responsable/Admin, PAS
    // seulement Admin Firebase comme le bloc générique /config/{docId}
    // ci-dessus — sans cette exception, un Responsable (session PIN) ne
    // pourrait jamais régler la référence DJU, alors que
    // assets/js/pages/cta-vc.js le lui permet déjà pour la gestion des
    // circuits (_canManage()). Lecture ouverte à tout rôle vérifié (le
    // moteur quantitatif en a besoin côté technicien pour afficher les
    // mêmes propositions que Responsable/Admin).
    // PASSE DE FIABILISATION (demande utilisateur) : validation serveur
    // complète des 6 champs de configuration générale, pas seulement le
    // rôle de l'auteur. Même principe déjà appliqué à heating_circuits
    // (chaque champ est OPTIONNEL — un réglage non encore défini reste
    // absent/null, jamais une valeur inventée — mais VALIDÉ quand
    // présent). hasOnly() interdit tout champ en dehors de cette liste
    // précise : un client ne peut pas glisser un champ arbitraire dans ce
    // document partagé par tous les rôles vérifiés en lecture.
    // Bornes cohérentes (min < max) revalidées ici pour ctaRangeMin/Max et
    // ctaWaterTempMin/Max — déjà revalidées côté client
    // (_saveHeatingConfigForm dans cta-vc.js) mais jamais QUE côté client :
    // un acteur contournant l'UI ne doit pas pouvoir écrire min >= max.
    match /config/heating_config {
      allow read: if isAnyVerifiedRole();
      allow create, update: if isResponsableOrAdmin()
        && request.resource.data.keys().hasOnly(['djuBaseTemp', 'ctaRangeMin', 'ctaRangeMax', 'vcMaxTemp', 'ctaWaterTempMin', 'ctaWaterTempMax', 'updatedAt'])
        && (!('djuBaseTemp' in request.resource.data) || request.resource.data.djuBaseTemp == null || (request.resource.data.djuBaseTemp is number && request.resource.data.djuBaseTemp > 0 && request.resource.data.djuBaseTemp <= 30))
        && (!('ctaRangeMin' in request.resource.data) || request.resource.data.ctaRangeMin == null || (request.resource.data.ctaRangeMin is number && request.resource.data.ctaRangeMin >= 0 && request.resource.data.ctaRangeMin <= 30))
        && (!('ctaRangeMax' in request.resource.data) || request.resource.data.ctaRangeMax == null || (request.resource.data.ctaRangeMax is number && request.resource.data.ctaRangeMax >= 0 && request.resource.data.ctaRangeMax <= 30))
        && (!('ctaRangeMin' in request.resource.data && 'ctaRangeMax' in request.resource.data) || request.resource.data.ctaRangeMin == null || request.resource.data.ctaRangeMax == null || request.resource.data.ctaRangeMin < request.resource.data.ctaRangeMax)
        && (!('vcMaxTemp' in request.resource.data) || request.resource.data.vcMaxTemp == null || (request.resource.data.vcMaxTemp is number && request.resource.data.vcMaxTemp > 0 && request.resource.data.vcMaxTemp <= 50))
        && (!('ctaWaterTempMin' in request.resource.data) || request.resource.data.ctaWaterTempMin == null || (request.resource.data.ctaWaterTempMin is number && request.resource.data.ctaWaterTempMin >= 0 && request.resource.data.ctaWaterTempMin <= 100))
        && (!('ctaWaterTempMax' in request.resource.data) || request.resource.data.ctaWaterTempMax == null || (request.resource.data.ctaWaterTempMax is number && request.resource.data.ctaWaterTempMax >= 0 && request.resource.data.ctaWaterTempMax <= 100))
        && (!('ctaWaterTempMin' in request.resource.data && 'ctaWaterTempMax' in request.resource.data) || request.resource.data.ctaWaterTempMin == null || request.resource.data.ctaWaterTempMax == null || request.resource.data.ctaWaterTempMin < request.resource.data.ctaWaterTempMax);
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    // Lecture   : libre (profil : nom, rôle, couleur, avatar… JAMAIS le PIN,
    //             voir users_private/{userId} ci-dessous)
    // Création  : Admin uniquement
    // Mise à jour : libre pour son propre profil (hors role/rank/roleId/pin),
    //             large pour Responsable/Admin (gestion d'équipe)
    // Suppression : Admin uniquement (panneau admin)
    match /users/{userId} {
      // CORRECTION AUDIT (session précédente) : le hash du PIN ne vit plus
      // dans ce document — déplacé vers users_private/{userId}, dont la
      // lecture est bloquée pour TOUT client (voir plus bas). Avant cette
      // correction, "allow read: if true" ici exposait le hash SHA-256 non
      // salé du PIN à quiconque, permettant un brute-force hors-ligne en
      // quelques millisecondes pour un PIN à 4-8 chiffres — verifyPin()
      // aurait alors accepté ce PIN deviné comme légitime, rendant la
      // vérification serveur inefficace contre cette voie de contournement.
      allow read: if true;
      allow create: if isAdmin();
      // AVANT : allow update: if true — n'importe qui (y compris une
      // session anonyme) pouvait réécrire le rôle/roleId/pin de N'IMPORTE
      // QUEL utilisateur, y compris le sien : élévation de privilège
      // triviale (ex. se déclarer "responsable" par un simple appel
      // Firestore direct, en contournant entièrement l'application).
      // APRÈS : un compte PIN vérifié (role/userId posés par verifyPin(),
      // jamais par le client) peut mettre à jour UNIQUEMENT SON PROPRE
      // document, et JAMAIS les champs role/rank/roleId (empêche toute
      // auto-élévation) — couvre les usages existants légitimes
      // (settings.js : changer son propre nom, avatar). Un Responsable
      // garde un accès complet à la gestion d'équipe (assignation de
      // roleId, etc.), exactement comme aujourd'hui via l'écran
      // Utilisateurs déjà accessible à canSeeAll() — aucune régression sur
      // cette fonctionnalité existante. Un Admin garde un accès total, y
      // compris pour changer le rôle d'un utilisateur.
      // 'pin' est EXCLU ICI POUR TOUT LE MONDE, y compris Responsable/Admin
      // : ce champ ne doit plus jamais réapparaître dans un document
      // publiquement lisible — seul users_private/{userId} (non lisible)
      // peut le contenir désormais. Sans cette exclusion, n'importe quelle
      // écriture autorisée par ailleurs (gestion d'équipe, self-service)
      // pourrait réintroduire par erreur le hash dans un endroit lisible de
      // tous, annulant la correction ci-dessous.
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pin'])
        && (
          isResponsableOrAdmin()
          || (
            request.auth != null
            && request.auth.token.firebase.sign_in_provider == 'custom'
            && ('userId' in request.auth.token)
            && request.auth.token.userId == userId
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'rank', 'roleId'])
          )
        );
      allow delete: if isAdmin();
    }

    // ── USERS_PRIVATE (correction audit : hash PIN, jamais lisible) ───────────
    // Contient UNIQUEMENT le champ `pin` (hash SHA-256, ou PIN en clair pour
    // un compte legacy pas encore migré) — jamais aucun autre champ. Lecture
    // bloquée pour TOUT client, y compris Admin : verifyPin()
    // (functions/index.js) le lit via l'Admin SDK, qui contourne de toute
    // façon les règles de sécurité — aucun client légitime n'a jamais besoin
    // de lire ce hash (la vérification de l'ancien PIN lors d'un changement
    // self-service passe elle aussi par verifyPin(), voir
    // assets/js/pages/settings.js:_confirmChangePin — plus par une
    // comparaison locale de hash).
    match /users_private/{userId} {
      allow read: if false;
      // CORRECTION AUDIT (session suivante) : un compte existant AVANT la
      // migration des données (voir scripts/migrate-pins-to-private.js),
      // ou dont la migration aurait échoué pour une raison quelconque, n'a
      // PAS encore de document users_private — sans cette branche, son
      // propre changement de PIN self-service (settings.js:
      // _confirmChangePin) serait traité comme un "create" (le document
      // n'existe pas) et rejeté par l'ancienne règle (allow create: if
      // isAdmin() uniquement), empêché PERMANENT jusqu'à une intervention
      // Admin manuelle. Prouvé par un test contre l'émulateur réel avant
      // cette correction (voir le rapport d'audit, et
      // tests/pin_security_test.js, section D).
      //
      // Un utilisateur peut donc désormais CRÉER son propre document
      // users_private — mais seulement sous TOUTES ces conditions à la
      // fois (chacune vérifiée indépendamment, aucune ne peut être
      // falsifiée côté client) :
      //   1. request.auth.token.firebase.sign_in_provider == 'custom'
      //      Ce claim n'est JAMAIS fourni par le client — il est dérivé
      //      par Firebase Auth lui-même de LA FAÇON dont le jeton a été
      //      obtenu (ici : admin.auth().createCustomToken(), appelé
      //      UNIQUEMENT par verifyPin(), côté serveur, avec la clé de
      //      service — jamais accessible au client). Un attaquant ne peut
      //      pas "se déclarer" sign_in_provider:'custom' depuis le client :
      //      soit son jeton a réellement été émis par verifyPin() (donc le
      //      PIN a été vérifié), soit ce claim ne vaudra jamais 'custom'.
      //   2. ('userId' in request.auth.token) && request.auth.token.userId
      //      == userId — le claim `userId` est posé par verifyPin()
      //      (functions/index.js:881, Admin SDK) à partir du compte dont
      //      LE PIN A RÉELLEMENT ÉTÉ VALIDÉ — jamais depuis une valeur
      //      fournie par le client dans la requête Firestore elle-même
      //      (qui ne pourrait de toute façon QUE lire request.auth.token,
      //      jamais le modifier après coup : un jeton Firebase est signé
      //      par le serveur et non falsifiable une fois émis). Comparé au
      //      paramètre de chemin {userId} du document ciblé : ne peut donc
      //      JAMAIS créer/modifier le document d'un AUTRE utilisateur.
      //   3. request.resource.data.keys().hasOnly(['pin']) &&
      //      request.resource.data.pin is string — la création ne peut
      //      JAMAIS introduire un autre champ que `pin` (empêche de
      //      glisser role/roleId ou tout autre champ dès la création).
      // Ensemble, ces 3 conditions garantissent qu'une création self-
      // service ne peut avoir lieu qu'APRÈS une authentification PIN
      // fiable (verifyPin, côté serveur) et UNIQUEMENT pour son propre
      // document, avec UNIQUEMENT le champ attendu.
      //
      // ── RÈGLE MÉTIER RESPONSABLE (section A.2 du rapport) ──
      // Un Responsable peut créer/réinitialiser le PIN de N'IMPORTE QUEL
      // TECHNICIEN (gestion d'équipe, déjà exposée aujourd'hui via
      // admin.js:renderUsers()/saveUsers(), accessible à canSeeAll() — pas
      // seulement à isAdmin()), mais JAMAIS celui d'un AUTRE Responsable ni
      // de l'Admin — _isResponsable(userId) lit le RÔLE RÉEL de la CIBLE
      // (Firestore, pas le jeton de l'appelant) pour trancher. Un
      // Responsable gérant son propre PIN passe par la branche self-
      // service ci-dessous (userId == soi-même), jamais par celle-ci.
      // Mêmes garanties de champ que le self-service : uniquement `pin`,
      // jamais un autre champ glissé dans la même écriture.
      allow create: if isAdmin()
        || (
          isPinRole('responsable')
          && !_isResponsable(userId)
          && request.resource.data.keys().hasOnly(['pin'])
          && request.resource.data.pin is string
        )
        || (
          request.auth != null
          && request.auth.token.firebase.sign_in_provider == 'custom'
          && ('userId' in request.auth.token)
          && request.auth.token.userId == userId
          && request.resource.data.keys().hasOnly(['pin'])
          && request.resource.data.pin is string
        );
      // Mise à jour : Admin (réinitialisation de n'importe quel PIN, y
      // compris celui d'un Responsable) OU Responsable réinitialisant le
      // PIN d'un TECHNICIEN uniquement (voir règle métier ci-dessus) OU
