    // days.{dayId}) — pas de suppression autorisée ici.
    match /week_slots/{docId} {
      allow read, create, update: if true;
    }

    // ── CTA/VC — CONSEILLER CHAUFFAGE (DJU, circuits, relevés, recommandations) ──
    // ⚠ RÈGLES TEMPORAIRES — environnement de test fermé, sans données
    // sensibles (validé explicitement par l'utilisateur pour accélérer les
    // essais de la V1). À REVOIR avant toute ouverture plus large de
    // l'application : ces 4 collections sont aussi permissives que
    // org_tasks/org_config (aucune restriction par rôle côté serveur), ce
    // qui est cohérent avec elles mais PAS un choix définitif pour de la
    // donnée de production.
    //
    // Suppression définitive interdite partout ici : archivage uniquement
    // pour les circuits (archiveHeatingCircuit), historique append-only
    // pour les relevés, expiration par changement de statut (jamais de
    // delete) pour les recommandations — cohérent avec la conservation
    // d'historique demandée pour ce module. Inchangé par cette migration.
    //
    // ── MIGRATION CUSTOM CLAIMS — Responsable/Technicien désormais
    // réellement distingués côté serveur via isPinRole()/isAnyVerifiedRole()
    // (voir les HELPERS en haut de ce fichier et functions/index.js:
    // verifyPin). CECI EST UN BROUILLON — NE PAS DÉPLOYER avant que :
    //  1. verifyPin soit déployée et validée en conditions réelles ;
    //  2. assets/js/auth.js utilise bien signInWithCustomToken() (plus la
    //     comparaison de hash côté client) pour CHAQUE connexion PIN ;
    //  3. computeDailyWeatherDju soit déployée (sans quoi weather_daily ne
    //     serait plus jamais alimenté une fois l'écriture client bloquée
    //     ci-dessous — voir le rapport de migration, section séquencement).
    // Tant que ces 3 conditions ne sont pas réunies, garder les règles
    // actuelles (permissives) déployées, pas celles-ci.
    match /heating_circuits/{docId} {
      allow read: if isAnyVerifiedRole();
      // Gestion des circuits ("installations", CONFIGURATION THERMIQUE) =
      // pilotage, réservé Responsable + Admin.
      // buildingId/vcMaxTemp/ctaRangeMin/ctaRangeMax/waterTempMin/
      // waterTempMax sont tous OPTIONNELS (circuits créés avant cette
      // refonte n'en ont aucun — jamais invalidés rétroactivement), mais
      // VALIDÉS quand présents. vcMaxTemp <= 50 est revérifié ICI (pas
      // seulement par MX.HeatingEngine côté client) : plafond de sécurité,
      // défense en profondeur.
      // CORRECTION — buildingId est désormais une VRAIE référence vers
      // heating_buildings/{id} (créé depuis Configuration thermique),
      // jamais un énumérable codé en dur ('batiment_1'/'batiment_2') :
      // seule la FORME (chaîne non vide ou null) est validée ici — une
      // vérification d'EXISTENCE coûterait une lecture supplémentaire par
      // écriture pour un gain de sécurité marginal (un buildingId orphelin
      // est déjà neutralisé côté moteur, voir
      // MX.HeatingEngine.proposeQuantitative : mode 'observation' par
      // prudence tant que le bâtiment n'est pas résolu).
      // CORRECTION 2 : ctaRangeMin/Max restent la plage de SOUFFLAGE
      // (air) ; waterTempMin/Max sont les limites, INDÉPENDANTES, de l'eau
      // de batterie — jamais fusionnées ni l'une validée à la place de
      // l'autre.
      allow create, update: if isResponsableOrAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && (!('buildingId' in request.resource.data) || request.resource.data.buildingId == null || (request.resource.data.buildingId is string && request.resource.data.buildingId.size() > 0))
        && (!('vcMaxTemp' in request.resource.data) || request.resource.data.vcMaxTemp == null || (request.resource.data.vcMaxTemp is number && request.resource.data.vcMaxTemp > 0 && request.resource.data.vcMaxTemp <= 50))
        && (!('ctaRangeMin' in request.resource.data) || request.resource.data.ctaRangeMin == null || (request.resource.data.ctaRangeMin is number && request.resource.data.ctaRangeMin >= 0 && request.resource.data.ctaRangeMin <= 30))
        && (!('ctaRangeMax' in request.resource.data) || request.resource.data.ctaRangeMax == null || (request.resource.data.ctaRangeMax is number && request.resource.data.ctaRangeMax >= 0 && request.resource.data.ctaRangeMax <= 30))
        && (!('waterTempMin' in request.resource.data) || request.resource.data.waterTempMin == null || (request.resource.data.waterTempMin is number && request.resource.data.waterTempMin >= 0 && request.resource.data.waterTempMin <= 100))
        && (!('waterTempMax' in request.resource.data) || request.resource.data.waterTempMax == null || (request.resource.data.waterTempMax is number && request.resource.data.waterTempMax >= 0 && request.resource.data.waterTempMax <= 100))
        // CORRECTION PRIORITAIRE (passe de finalisation) : tempMin/tempMax
        // = "température minimale/maximale autorisée" du formulaire
        // installation (Configuration thermique) — bornes GÉNÉRALES,
        // resserrant TOUTE grandeur chiffrée de l'installation (soufflage,
        // eau de batterie, eau VC), voir MX.HeatingEngine.
        // _intersectGeneralLimits(). Revalidées ici pour la même raison que
        // vcMaxTemp ci-dessus : défense en profondeur, pas seulement côté
        // client.
        && (!('tempMin' in request.resource.data) || request.resource.data.tempMin == null || (request.resource.data.tempMin is number && request.resource.data.tempMin >= 0 && request.resource.data.tempMin <= 100))
        && (!('tempMax' in request.resource.data) || request.resource.data.tempMax == null || (request.resource.data.tempMax is number && request.resource.data.tempMax >= 0 && request.resource.data.tempMax <= 100));
    }
    // ── CONFIGURATION THERMIQUE — bâtiments ──
    // mode:'automatique'|'manuel_assiste' uniquement — c'est CE champ que
    // le moteur (MX.HeatingEngine.proposeQuantitative/evaluateCircuit) lit
    // pour exclure toute proposition/action de réglage manuel sur un
    // bâtiment automatique ; une valeur hors de cette liste serait un état
    // ambigu dangereux (ni surveillance ni pilotage clairement établis),
    // donc rejetée ici.
    match /heating_buildings/{docId} {
      allow read: if isAnyVerifiedRole();
      allow create, update: if isResponsableOrAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.mode in ['automatique', 'manuel_assiste'];
    }
    // ── CONFIGURATION THERMIQUE — pièces ──
    // Gestion structurelle réservée Responsable/Admin (section 8 du
    // cahier des charges) ; le technicien ne peut que LIRE (choisir la
    // bonne pièce pour un relevé, voir heating_readings.roomId ci-dessous)
    // et SAISIR un relevé — jamais créer/modifier/archiver une pièce.
    match /heating_rooms/{docId} {
      allow read: if isAnyVerifiedRole();
      allow create, update: if isResponsableOrAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.buildingId is string && request.resource.data.buildingId.size() > 0;
    }
    // ── CONFIGURATION THERMIQUE — courbes DJU / température intérieure ──
    // SEULE collection heating_* où la suppression est autorisée (points de
    // référence saisis par un humain, jamais une mesure historique — voir
    // assets/js/db.js:deleteHeatingCurvePoint). Toujours Responsable/Admin.
    match /heating_curve_points/{docId} {
      allow read: if isAnyVerifiedRole();
      allow create, update: if isResponsableOrAdmin()
        && request.resource.data.buildingId is string && request.resource.data.buildingId.size() > 0
        && request.resource.data.dju is number
        && request.resource.data.expectedIndoorTemp is number;
      allow delete: if isResponsableOrAdmin();
    }
    // ── CONFIGURATION THERMIQUE — journal d'audit ──
    // Append-only (jamais de update/delete) : trace ancienne/nouvelle
    // valeur, utilisateur, date pour chaque modification de configuration
    // structurelle (section 7 du cahier des charges). Écrit uniquement par
    // Responsable/Admin, cohérent avec le fait que seules ces actions sont
    // elles-mêmes réservées à ces rôles.
    match /heating_config_audit/{docId} {
      allow read: if isResponsableOrAdmin();
      allow create: if isResponsableOrAdmin()
        && request.resource.data.entityType in ['building', 'installation', 'room', 'curve_point']
        && request.resource.data.entityId is string
        && request.resource.data.at == request.time;
      // allow update, delete : interdit (append-only)
    }
    match /heating_readings/{docId} {
      // Lecture nécessaire au technicien pour choisir le bon circuit et
      // consulter l'historique (calcul des DJU) — jamais restreinte à
      // Responsable/Admin, contrairement aux 3 autres collections.
      allow read: if isAnyVerifiedRole();
      // Création ouverte à TOUT rôle vérifié (c'est l'action centrale
      // demandée pour le technicien) — mais jamais en blanc : validation
      // minimale des champs pour écarter une écriture arbitraire/abusive.
      // createdAt DOIT être un vrai horodatage serveur (FieldValue.
      // serverTimestamp()) : request.resource.data.createdAt == request.time
      // n'est vrai que pour ce sentinel, jamais pour une date fournie par
      // le client.
      //
      // REFONTE CTA/VC : un relevé D'INSTALLATION (circuitId) est désormais
      // soit l'ANCIENNE forme à un seul point (`temp`, inchangée — jamais
      // retirée, l'historique déjà écrit reste lisible et de nouveaux
      // relevés "simples" restent possibles pour les circuits hors CTA/VC),
      // soit la NOUVELLE forme à 2 points (`points.point1`/`points.point2`,
      // voir _validHeatingPoint ci-dessus) — jamais les deux absentes à la
      // fois, jamais un mélange invalide.
      //
      // CONFIGURATION THERMIQUE : un relevé peut ALTERNATIVEMENT porter sur
      // une PIÈCE (roomId) — température ambiante simple uniquement,
      // jamais `points` (une pièce n'a pas de "2 points de réseau") —
      // alimente MX.HeatingEngine.computeBuildingAverageTemp. circuitId et
      // roomId sont mutuellement exclusifs : un relevé ne peut jamais
      // porter sur les deux à la fois (empêcherait de savoir sans ambiguïté
      // s'il s'agit d'un relevé d'installation ou de pièce).
      // Chaque branche est gardée par un test 'in' AVANT tout accès par
      // notation pointée (request.resource.data.circuitId / .roomId /
      // .points) : un champ ABSENT accédé en notation pointée lève une
      // erreur d'évaluation CEL (jamais une simple valeur "absente"), ce
      // qui aurait fait échouer TOUTE l'expression — y compris la branche
      // circuitId pourtant valide — dès qu'une seule des deux branches
      // référence un champ non présent sur ce document précis. Même
      // précaution déjà appliquée ailleurs dans ce fichier (voir
      // _isResponsable ci-dessus).
      allow create: if isAnyVerifiedRole()
        && !(('circuitId' in request.resource.data) && ('roomId' in request.resource.data))
        && (
          (
            ('circuitId' in request.resource.data)
            && request.resource.data.circuitId is string && request.resource.data.circuitId.size() > 0
            && (
              (('temp' in request.resource.data) && request.resource.data.temp is number && request.resource.data.temp > -50 && request.resource.data.temp < 100)
              || (
                ('points' in request.resource.data) && request.resource.data.points is map
                && _validHeatingPoint(request.resource.data.points.point1)
                && _validHeatingPoint(request.resource.data.points.point2)
              )
            )
          )
          || (
            ('roomId' in request.resource.data)
            && request.resource.data.roomId is string && request.resource.data.roomId.size() > 0
            && ('temp' in request.resource.data) && request.resource.data.temp is number && request.resource.data.temp > -50 && request.resource.data.temp < 100
            && !('points' in request.resource.data)
          )
        )
        && request.resource.data.createdAt == request.time
        && (!('comment' in request.resource.data) || (request.resource.data.comment is string && request.resource.data.comment.size() <= 500))
        // PASSE DE FIABILISATION (demande utilisateur) — "l'auteur [d'un
        // relevé] ne peut pas être falsifié depuis le client" : pour un
        // compte PIN (Technicien ou Responsable, sign_in_provider=='custom'),
        // `author` doit correspondre EXACTEMENT au vrai nom enregistré du
        // titulaire du jeton (users/{userId}.name, lu via le claim userId —
        // posé UNIQUEMENT par la Cloud Function verifyPin, jamais
        // modifiable par le client, voir functions/index.js). Un technicien
        // ne peut donc jamais écrire un relevé au nom d'un collègue ou d'un
        // nom inventé — seul SON PROPRE nom, tel qu'enregistré côté serveur,
        // est accepté. Un Admin Firebase (sign_in_provider != 'custom') n'a
        // pas de claim userId correspondant à users/{id} de la même façon
        // (compte email/mot de passe) : non concerné par cette vérification
        // supplémentaire, déjà pleinement privilégié ailleurs dans ce
        // fichier.
        && (!('author' in request.resource.data) || (
          request.resource.data.author is string && request.resource.data.author.size() <= 120
          && (
            request.auth.token.firebase.sign_in_provider != 'custom'
            || request.resource.data.author == get(/databases/$(database)/documents/users/$(request.auth.token.userId)).data.name
          )
        ));
      // Toujours append-only : aucun allow update ici (inchangé).
    }
    match /heating_recommendations/{docId} {
      allow read: if isAnyVerifiedRole();
      // Création : UNIQUEMENT un statut INITIAL — 'a_examiner' (moteur v1
      // qualitatif, inchangé) ou 'proposition_generee' (moteur v2
      // quantitatif, REFONTE CTA/VC — voir cta-vc.js). N'importe quel rôle
      // vérifié peut déclencher ces écritures (ce sont des CANDIDATS
      // calculés, pas des décisions), mais ne peut JAMAIS créer directement
      // un document déjà dans un statut de décision/avancement — empêche de
      // contourner le cycle de validation en créant un nouveau document
      // plutôt qu'en modifiant.
      allow create: if isAnyVerifiedRole()
        && request.resource.data.circuitId is string
        && request.resource.data.createdAt == request.time
        && (
          request.resource.data.status == 'a_examiner'
          || (request.resource.data.status == 'proposition_generee' && request.resource.data.engineVersion == 'v2')
        );
      // Modification :
      //  - Responsable/Admin : toute transition (décision pilotage — accepter/
      //    refuser/reporter/valider/appliquer/confirmer/contrôler).
      //  - Technicien (et tout rôle vérifié) : UNIQUEMENT les transitions du
      //    cycle v2 qui correspondent à une action PHYSIQUE qu'il doit pouvoir
      //    réaliser seul (réglage effectué, consigne confirmée, contrôle
      //    effectué) — jamais la décision de valider/refuser/reporter une
      //    proposition, réservée au pilotage — ET jamais depuis un statut qui
      //    ne précède pas normalement celui demandé (machine à états stricte,
      //    pas un simple changement de champ libre).
      //  - EN PLUS, tout rôle vérifié peut déclencher la seule transition
      //    automatique "a_examiner -> expiree" (moteur v1, inchangée — voir
      //    cta-vc.js:_expireStaleRecommendations).
      allow update: if isResponsableOrAdmin()
        || (
          isAnyVerifiedRole()
          && resource.data.status == 'a_examiner'
          && request.resource.data.status == 'expiree'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'expiredAt'])
        )
        || (
          isAnyVerifiedRole() && resource.data.engineVersion == 'v2'
          && (
            (resource.data.status == 'validee' && request.resource.data.status == 'reglage_effectue'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'appliedAt', 'appliedBy', 'appliedValue']))
            || (resource.data.status == 'reglage_effectue' && request.resource.data.status == 'consigne_confirmee'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'confirmedAt', 'confirmedBy', 'confirmedValue']))
            || (resource.data.status == 'consigne_confirmee' && request.resource.data.status == 'controle_effectue'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'controlledAt', 'controlledBy', 'controlReadingId']))
          )
        );
    }
    match /weather_daily/{docId} {
      allow read: if isAnyVerifiedRole();
      // Écriture SERVEUR UNIQUEMENT (computeDailyWeatherDju, Admin SDK —
      // qui contourne de toute façon ces règles) : plus aucune écriture
      // client, y compris depuis assets/js/app.js:_ensureDailyDjuPersisted,
      // qui devra être retirée/désactivée côté client avant déploiement de
      // cette règle (voir dépendance de séquencement ci-dessus, condition 3).
      allow create, update: if false;
    }

  }
}
